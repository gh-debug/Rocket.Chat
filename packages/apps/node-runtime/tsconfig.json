{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"rootDir": "./src",
		"outDir": "./dist",
		"types": ["node"],
		"lib": ["es2023"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"target": "es2023",
		"declaration": false,
	},
	"include": ["./src/**/*"],
	"exclude": ["./src/**/*.spec.ts", "./src/**/*.test.ts","./src/**/tests/*"]
}
